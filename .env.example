# Each learner types her own passphrase once per device (no accounts); it decides whose data she sees.
# Learner 1 (Lucka; existing data belongs to her). Must differ from learner 2's.
LEARNER_1_PASSPHRASE=
# Optional: greeting name in the vocative ("Ahoj Lucko") and exam date (YYYY-MM-DD, default 2026-12-04)
LEARNER_1_NAME=
LEARNER_1_EXAM_DATE=
# Learner 2 (Danča). Leave the passphrase empty to disable her login.
LEARNER_2_PASSPHRASE=
LEARNER_2_NAME=
LEARNER_2_EXAM_DATE=
# Optional: names as the admin area shows them (nominative; defaults "Lucka" / "Danča")
LEARNER_1_LABEL=
LEARNER_2_LABEL=
# Admin area at /admin (read-only overview of both learners + content explorer). Empty = admin area off.
# Must differ from both learner passphrases.
ADMIN_PASSPHRASE=
# ≥ 16 random characters; signs the session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=
# Neon Postgres connection string. Leave empty locally to use embedded PGlite (.pglite/).
DATABASE_URL=
# Optional: PGlite data directory (default .pglite)
PGLITE_DIR=
